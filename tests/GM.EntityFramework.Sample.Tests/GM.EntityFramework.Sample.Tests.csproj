<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- NU1903: transitive SQLite native lib advisory; test-only, never shipped. -->
        <NoWarn>$(NoWarn);NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\GM.EntityFramework.Sample.Application\GM.EntityFramework.Sample.Application.csproj" />
        <ProjectReference Include="..\..\GM.EntityFramework.Sample.Persistence\GM.EntityFramework.Sample.Persistence.csproj" />
        <ProjectReference Include="..\..\GM.EntityFramework.Sample.Domain\GM.EntityFramework.Sample.Domain.csproj" />
    </ItemGroup>

</Project>
